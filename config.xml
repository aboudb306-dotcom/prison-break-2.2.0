<?xml version='1.0' encoding='utf-8'?>
<widget id="com.darkkingdom.prisonbreak" version="2.2.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Prison Break Beta</name>
    <description>Prison Break - Online Beta</description>
    <author email="you@example.com">Dark_KINGDOM</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="https://prison-break-server.onrender.com/*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="landscape" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="ScrollEnabled" value="false" />
</widget>
